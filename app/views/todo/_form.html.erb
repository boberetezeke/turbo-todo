<%= turbo_frame_tag "new_todo" do %>
  <% if todo.errors.any? %>
    <div>
      <p><%= pluralize(todo.errors.count, "error") %> prevented this todo from being saved:</p>

      <ul>
        <% todo.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: todo, url: todo_index_path do |form| %>
    <div class="todo-form-row">
      <%= form.text_field :title, placeholder: "What needs to be done?", required: true, autofocus: true, class: "todo-title-input" %>
      <div data-controller="datepicker">
        <input data-datepicker-target="input" type="text" name="todo[deadline]" value="" class="todo-title-input"/>
        <button data-datepicker-target="toggle">
          <svg><use href="#calendar-icon"/></svg>
        </button>
      </div>
      <%= form.label :severity %>
      <%= form.select(:severity, { "Low" => 1, "Medium Low" => 2, "Medium" => 3, "Medium High" => 4, "High" => 5 }, {}, class: "todo-select") %>
      <%= form.label :difficulty %>
      <%= form.select(:difficulty, { "Low" => 1, "Medium Low" => 2, "Medium" => 3, "Medium High" => 4, "High" => 5 }, {}, class: "todo-select") %>
      <%= form.submit "Add", class: "todo-submit-button" %>
    </div>
  <% end %>
<% end %>

